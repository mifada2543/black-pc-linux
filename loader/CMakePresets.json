{
  "version": 6,
  "configurePresets": [
    {
      "name": "win32",
      "displayName": "Win32 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win32"
    },
    {
      "name": "win32-vs2022",
      "displayName": "Win32 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win32-vs2022"
    },
    {
      "name": "linux",
      "displayName": "Linux i386 (Ninja, 32-bit)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32"
      }
    }
  ],
  "buildPresets": [
    { "name": "win32-release", "configurePreset": "win32", "configuration": "RelWithDebInfo" },
    { "name": "win32-debug", "configurePreset": "win32", "configuration": "Debug" },
    { "name": "linux", "configurePreset": "linux" }
  ],
  "testPresets": [
    { "name": "linux", "configurePreset": "linux", "output": {"outputOnFailure": true} }
  ]
}
